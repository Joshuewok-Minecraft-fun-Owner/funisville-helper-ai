{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-ai-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Object that owns one live stream "session": chat log,
  // rolling transcript+vision+chat highlight detection, manual triggers.
  "durable_objects": {
    "bindings": [
      { "name": "STREAM_SESSION", "class_name": "StreamSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StreamSession"] }
  ],

  // D1 for anything you want to query/report on later: chat log,
  // highlight list, job status.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stream-agent-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // Workers AI: Whisper (transcription), a vision model (frame
  // captioning), and a text model (highlight judgment).
  "ai": {
    "binding": "AI"
  },

  // Media Transformations: pulls frames/spritesheets out of short
  // video chunks without needing ffmpeg or Containers.
  "media": {
    "binding": "MEDIA"
  },

  // Optional: only needed if you want to store final highlight
  // clips or exported transcripts somewhere durable.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "stream-agent-assets"
    }
  ],

  "vars": {
    "TWITCH_CLIENT_ID": "REPLACE_WITH_YOUR_TWITCH_CLIENT_ID",
    "TWITCH_CHANNEL": "REPLACE_WITH_YOUR_CHANNEL_LOGIN",
    "DETECTION_INTERVAL_SECONDS": "25",
    // Auto-request a Meld clip (via /pending-clips) only above this
    // confidence - keep it higher than you'd accept for the reviewable
    // list, since this one skips your judgment entirely.
    "AUTO_CLIP_CONFIDENCE_THRESHOLD": "0.75"
  }

  // Secrets (set with `wrangler secret put <NAME>`, do not put here):
  //   TWITCH_EVENTSUB_SECRET   - verifies EventSub webhook signatures
  //   DISCORD_WEBHOOK_URL      - optional, for "job ready" notifications
  //   MELD_BRIDGE_TOKEN        - shared secret the local bridge script uses
}
